# Deployment settings for the CVAT stack in this directory.
# Copy to infra/.env — docker compose reads it from the compose file's own
# directory, not from wherever you run make.
#
# The credentials the CLI uses to TALK to CVAT live in the repo-root .env
# instead (CVAT_URL / CVAT_USERNAME / CVAT_PASSWORD).

# CVAT release to run. Must match the version infra/docker-compose.yaml was
# vendored from — see README.md before bumping it.
CVAT_VERSION=v2.75.0

# Hostname traefik routes on. Serves the UI at http://$CVAT_HOST:8080
CVAT_HOST=localhost

# Optional: host directory exposed as CVAT's file share, for annotating images
# already on this machine (CVAT records those tasks with storage='share').
# Tasks created by `cli.py create-cvat-task` upload their frames instead and do
# not need this. Must be an absolute path; leave unset for a Docker-managed
# volume. Update it if you rename or move the checkout.
# CVAT_SHARE_PATH=/absolute/path/to/sokil/images
